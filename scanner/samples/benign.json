{
  "serverInfo": {"name": "docs-reader", "version": "1.2.0"},
  "scopes": ["docs.read"],
  "tools": [
    {
      "name": "get_document",
      "description": "Return the text of one document by its ID.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {"doc_id": {"type": "string", "pattern": "^[a-z0-9-]{1,40}$"}}
      },
      "annotations": {"readOnlyHint": true}
    },
    {
      "name": "list_documents",
      "description": "List document titles in a folder.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {"folder": {"type": "string", "enum": ["policies", "procedures"]}}
      },
      "annotations": {"readOnlyHint": true}
    }
  ]
}
